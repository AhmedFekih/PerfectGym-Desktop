<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10.0" prefWidth="400.0"  stylesheets="@Style.css" prefHeight="300.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.pidev.controllers.AjouterAbonnement">
    <children>
        <Label text="Nom de l'abonnement" />
        <TextField fx:id="nomAbonnementField" />

        <Label text="Date de début" />
        <DatePicker fx:id="startDatePicker" />

        <Label text="Date de fin" />
        <DatePicker fx:id="endDatePicker" editable="false" />

        <Button text="Confirmer Abonnement" onAction="#confirmerAbonnement" />
        <Button text="Annuler" onAction="#annuler" />
    </children>
</VBox>
