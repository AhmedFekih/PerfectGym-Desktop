<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="616.0" prefWidth="832.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.pidev.controllers.ListeOffresClient">
    <children>
        <!-- Barre de recherche -->
        <HBox fx:id="searchBarContainer" layoutX="156.0" layoutY="44.0" spacing="10" style="-fx-padding: 10;">
            <ComboBox fx:id="comboBoxCategorie" promptText="Choisir une catégorie" />
            <ComboBox fx:id="comboBoxStatut" promptText="Choisir un statut" />
            <Button onAction="#rechercherOffres" style="-fx-background-color: #4caf50 ; -fx-text-fill: white;" text="Rechercher" />
            <Button onAction="#reinitialiserRecherche" style="-fx-background-color: #4caf50 ; -fx-text-fill: white;" text="Réinitialiser" />
        </HBox>

        <!-- Bouton "Mes Abonnements" -->
        <Button fx:id="btnVoirAbonnements" layoutX="691.0" layoutY="27.0" onAction="#afficherMesAbonnements" style="-fx-background-color: #4caf50 ; -fx-text-fill: white;" text="Mes Abonnements" />

        <!-- ScrollPane pour afficher les offres -->
        <ScrollPane fitToWidth="true" layoutX="83.0" layoutY="98.0" prefHeight="503.0" prefWidth="717.0">
            <content>
                <VBox fx:id="offresContainer" prefHeight="184.0" prefWidth="611.0" spacing="20" style="-fx-padding: 20;" />
            </content>
        </ScrollPane>
      <Button onAction="#retourSalle" layoutX="29.0" layoutY="14.0" mnemonicParsing="false" style="-fx-background-color: #4caf50; -fx-text-fill: white;" text="Retour au liste des salles " />
    </children>
</AnchorPane>
