<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.web.WebView?>

<AnchorPane xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.pidev.controllers.MapController">
   <children>
   
          <!-- WebView for displaying the Leaflet map -->
       <WebView fx:id="mapWebView" />
       <!-- TextField for entering place -->
       <TextField fx:id="placeTextField" layoutX="74.0" layoutY="14.0" promptText="Enter a place name" />
   
          <!-- Button to trigger search -->
       <Button layoutX="14.0" layoutY="14.0" onAction="#handleSearchButtonAction" text="Search" />
      <Button layoutX="14.0" layoutY="58.0" onAction="#cancelAddPlanning" text="return" />
   </children>
</AnchorPane>
